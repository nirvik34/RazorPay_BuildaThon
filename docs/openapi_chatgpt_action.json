{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentPay Guard API",
    "version": "0.1.0",
    "description": "API for autonomous agent payment requests, registration, and intent management protected by AgentPay Guard."
  },
  "servers": [
    {
      "url": "https://stubbly-impotent-escargot.ngrok-free.dev"
    }
  ],
  "paths": {
    "/agent/register": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Register Agent",
        "operationId": "register_agent_agent_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAgentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterAgentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/payment-request": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Submit Payment Request",
        "description": "Submit a payment request to AgentPay Guard. Holds connection up to 25s for approval. If status is PENDING or approvalRequired is true, immediately call /agent/payment-status/{request_id} (or 'latest') to poll for approval. Do not stop until status is checked.",
        "operationId": "payment_request_agent_payment_request_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequestIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequestResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/payment-status/{request_id}": {
      "get": {
        "tags": [
          "agent"
        ],
        "summary": "Check or Poll Payment Status",
        "description": "Poll the status of a payment request. Supports request_id string or 'latest'. If status is PENDING, the server will wait for approval before returning. Poll this endpoint until status becomes APPROVED, AUTHORIZED, or DENIED.",
        "operationId": "payment_status_agent_payment_status__request_id__get",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "wait_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 15
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/intent": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Create Intent",
        "operationId": "create_intent_agent_intent_post",
        "parameters": [
          {
            "name": "agentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntentResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterAgentIn": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "title": "Agent ID"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "trustScore": {
            "type": "integer",
            "title": "Trust Score",
            "default": 70
          },
          "policyId": {
            "type": "string",
            "title": "Policy ID",
            "default": "pol_default"
          }
        },
        "required": [
          "agentId",
          "name"
        ]
      },
      "RegisterAgentResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "OK Status"
          },
          "agentId": {
            "type": "string",
            "title": "Agent ID"
          }
        }
      },
      "PaymentRequestIn": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Request ID"
          },
          "agentId": {
            "type": "string",
            "title": "Agent ID"
          },
          "intentId": {
            "type": "string",
            "title": "Intent ID"
          },
          "merchant": {
            "type": "string",
            "title": "Merchant"
          },
          "product": {
            "type": "string",
            "title": "Product"
          },
          "amount": {
            "type": "integer",
            "title": "Amount in INR (e.g. 599 for ₹599)",
            "description": "Amount in main currency units (e.g. 599 for ₹599 INR). Do NOT convert or multiply by 100 to paise."
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "INR"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "sessionId": {
            "type": "string",
            "title": "Session ID"
          }
        },
        "required": [
          "agentId",
          "merchant",
          "product",
          "amount",
          "category"
        ]
      },
      "PaymentRequestResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Request ID"
          },
          "decision": {
            "type": "string",
            "title": "Decision (AUTO_APPROVE, USER_APPROVAL, BLOCK)"
          },
          "riskScore": {
            "type": "integer",
            "title": "Risk Score"
          },
          "expiresAt": {
            "type": "string",
            "title": "Expiration Timestamp"
          }
        }
      },
      "PaymentStatusResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Request ID"
          },
          "status": {
            "type": "string",
            "title": "Status (PENDING, APPROVED, EXPIRED, CAPTURED)"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "checkoutUrl": {
            "type": "string",
            "title": "Razorpay Checkout URL"
          }
        }
      },
      "IntentIn": {
        "type": "object",
        "properties": {
          "intentId": {
            "type": "string",
            "title": "Intent ID"
          },
          "goal": {
            "type": "string",
            "title": "Goal"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "budget": {
            "type": "integer",
            "title": "Budget"
          }
        },
        "required": [
          "goal",
          "category",
          "budget"
        ]
      },
      "IntentResponse": {
        "type": "object",
        "properties": {
          "intentId": {
            "type": "string",
            "title": "Intent ID"
          }
        }
      }
    }
  }
}