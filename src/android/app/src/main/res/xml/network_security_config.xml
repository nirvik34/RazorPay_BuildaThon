<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-scoped cleartext: allowed only for the local backend endpoints
  (emulator loopback + localhost). Physical-phone users on LAN must add
  their PC's IP here, e.g. <domain includeSubdomains="false">192.168.1.5</domain>.
  Everything else (ngrok, production) is HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
